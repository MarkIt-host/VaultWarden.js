{
  "name": "vaultwarden",
  "version": "1.0.1",
  "description": "A modern, object-oriented TypeScript SDK for Vaultwarden/Bitwarden servers",
  "keywords": [
    "vaultwarden",
    "bitwarden",
    "password-manager",
    "vault",
    "sdk",
    "oop",
    "discord.js-style"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --sourcemap --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "vault-tester": "tsx scripts/vault-tester.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "ansi-styles": "^5.2.0",
    "any-promise": "^1.3.0",
